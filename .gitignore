# Pourquoi: Ne pas versionner les fichiers de configuration contenant des secrets
appsettings.json
appsettings.Development.json
appsettings.Production.json
appsettings.*.json
# Jamais committer de secrets — utiliser des variables d'environnement en production

# Pourquoi: Ne pas versionner les fichiers compilés générés par .NET
bin/
obj/
run/

# Pourquoi: Ne pas versionner les dossiers de configuration spécifiques à Visual Studio
.vs/

# Pourquoi: Ne pas versionner la base de données SQLite locale pour éviter de partager des données privées
*.db

# Pourquoi: Ne pas versionner les préférences utilisateur spécifiques à l'IDE (Visual Studio/VS Code)
*.user
*.suo

# Pourquoi : Ne pas versionner les logs de build, d'erreurs et de migration temporaires
*build_errors*.txt
*build_logs*.txt
*build_output*.txt
restore_errors.txt
full_build_log.txt
migration_output.txt
ef_migration_output.txt

# Pourquoi : Ne pas versionner les fichiers de cache Python ou les environnements virtuels
__pycache__/
*.pyc
.env
.env.*

# Pourquoi : Ne pas versionner les fichiers de contexte volumineux d'IA
APEX_AI_STUDIO_CONTEXT.md
